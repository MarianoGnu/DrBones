; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dr Bones"
run/main_scene="res://title/title.tscn"
config/features=PackedStringArray("4.1", "Forward Plus")
config/icon="res://bones/normal/Cabeza Merged.PNG"
config/windows_native_icon="res://icon.ico"

[autoload]

Audio="*res://autoload/Audio.tscn"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://playground/theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://localization/dialogs.es.translation")
locale/fallback="es"
